# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore - never commit a real key.

# Model provider: fill at least one key. LLM_PROVIDER=auto uses Groq if GROQ_API_KEY is set,
# otherwise OpenRouter. MODEL_NAME empty = the provider's default
# (groq: openai/gpt-oss-20b, openrouter: meta-llama/llama-3.1-8b-instruct).
# Providers retire models: check the provider's models page if you get "model_not_found".
# Model names differ between providers - change MODEL_NAME when you change provider.
OPENROUTER_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
LLM_PROVIDER=auto
MODEL_NAME=
# Calls: timeout (s), retries per call, seconds between calls (empty = provider default:
# groq 2.1, openrouter 3.1), consecutive failed calls before the provider is treated as down
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_MIN_INTERVAL_S=
LLM_CIRCUIT_BREAKER=3
# Replies are cached by (model, prompt): re-runs cost no API calls. Delete the file to force fresh calls.
LLM_CACHE_PATH=./storage/llm_cache.sqlite
# Answer drafting: PR-02 version ("" = newest in prompts/), articles sent to the model (the 2nd
# only if its score is within the margin of the best), and the answer length cap in tokens
PROMPT_PR02_VERSION=
GENERATION_MAX_ARTICLES=2
GENERATION_SCORE_MARGIN=0.10
GENERATION_MAX_TOKENS=400
# true = write escalation notes with the LLM (PR-03); false = deterministic template, no API calls
ESCALATION_NOTE_LLM=false

# Embeddings and vector index
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DOCS_PATH=./data/documentation.json
CHUNK_STRATEGY=section

# Retrieval: chunks fetched before grouping, articles kept, similarity cut-off
RETRIEVAL_TOP_K=12
RETRIEVAL_MAX_DOCS=3
RELEVANCE_THRESHOLD=0.35

# Classifier (scripts/train_classifier.py); below the floor the intent becomes unclear_request
CLASSIFIER_PATH=./storage/classifier.joblib
CLASSIFIER_FLOOR=0.30

# Routing: below this intent confidence the ticket escalates (chosen from data, docs/decisions/routing.md)
CONFIDENCE_THRESHOLD=0.80
# Intents that always go to a person, whatever the confidence (FR-05)
MUST_ESCALATE_INTENTS=security_incident,compliance_request,feature_request,unclear_request
# Kill switch: set to false to stop ALL automatic answers immediately (every ticket escalates)
AUTO_RESPOND_ENABLED=true

# Decision log
DATABASE_URL=sqlite:///./storage/decisions.db
LOG_LEVEL=INFO
