# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore - never commit a real key.

# Model provider: fill at least one key
OPENROUTER_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct

# Embeddings and vector index
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DOCS_PATH=./data/documentation.json
CHUNK_STRATEGY=section

# Retrieval: chunks fetched before grouping, articles kept, similarity cut-off
RETRIEVAL_TOP_K=12
RETRIEVAL_MAX_DOCS=3
RELEVANCE_THRESHOLD=0.35

# Classifier (scripts/train_classifier.py); below the floor the intent becomes unclear_request
CLASSIFIER_PATH=./storage/classifier.joblib
CLASSIFIER_FLOOR=0.30

# Decision log and routing
DATABASE_URL=sqlite:///./storage/decisions.db
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
